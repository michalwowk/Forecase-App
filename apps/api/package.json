{
	"name": "@forecase/api",
	"private": true,
	"type": "module",
	"exports": {
		"./schema.graphql": "./schema.graphql"
	},
	"scripts": {
		"codegen": "graphql-codegen --config codegen.ts",
		"dev": "pnpm codegen && pnpm \"/^dev:/\"",
		"dev:codegen": "node --watch-path=schema.graphql --watch-preserve-output node_modules/@graphql-codegen/cli/esm/bin.js --config codegen.ts",
		"dev:server": "tsx watch --include schema.graphql --env-file=.env.development --env-file-if-exists=.env src/index.ts",
		"build": "tsdown src/index.ts",
		"start": "node --env-file-if-exists=.env dist/index.mjs",
		"test": "pnpm codegen && vitest run",
		"typecheck": "pnpm codegen && tsc",
		"lint": "biome check ."
	},
	"dependencies": {
		"graphql": "^17.0.2",
		"graphql-yoga": "^5.24.6",
		"pino": "^10.4.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@graphql-codegen/cli": "^7.4.6",
		"@graphql-codegen/typescript": "^6.1.2",
		"@graphql-codegen/typescript-resolvers": "^6.1.1",
		"@types/node": "^24.19.2",
		"msw": "^3.0.3",
		"pino-pretty": "^13.2.0",
		"tsdown": "^0.23.1",
		"tsx": "^4.23.15",
		"vitest": "^5.0.5"
	}
}
